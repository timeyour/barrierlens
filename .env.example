GEMINI_API_KEY=
# 兼容旧变量名
GEMMA_API_KEY=
GEMMA_MODEL_NAME=gemma-4-26b-a4b-it
# Vercel 建议 55000；本地可 25000
GEMMA_API_TIMEOUT_MS=55000
GEMMA_API_RETRY_ATTEMPTS=2
# 生产环境 Gemma 失败时是否仍降级 Mock（默认 false，避免假识图结果）
ALLOW_MOCK_FALLBACK=false
# 本地网络需要代理时填写，例如 http://127.0.0.1:7897；Vercel 通常留空
GEMMA_API_PROXY=

# 本地 Ollama（Google API 不可用时自动 fallback，或 OLLAMA_PREFERRED=true 优先）
# 本地开发可在 .env.local 设为 true；Vercel 生产请保持 false
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_TIMEOUT_MS=180000
# 设为 true 时跳过 Google，直接用本机 Ollama（本地开发推荐）
OLLAMA_PREFERRED=false
NEXT_PUBLIC_OLLAMA_PREFERRED=false
NEXT_PUBLIC_ANALYZE_TIMEOUT_MS=180000

# 脚本调用 /api/analyze 的密钥（可选）
# 脚本/Postman 可携带：Authorization: Bearer <TEAM_API_KEY>
TEAM_API_KEY=

# 可选登录同步（Supabase Auth Magic Link）
# 生产站点根 URL（与 Supabase Auth → Site URL 一致，勿带末尾斜杠）
NEXT_PUBLIC_SITE_URL=https://barrierlens-1utx.vercel.app
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_AUTH_REQUIRED=false
NEXT_PUBLIC_STORAGE_MODE=local_first

NEXT_PUBLIC_V2_ENABLED=true
NEXT_PUBLIC_V2_BARRIER_MAP_ENABLED=true
NEXT_PUBLIC_V2_REVIEW_FLOW_ENABLED=true

# 工作台布局：default（双卡片）| compact（单卡片一屏）
# URL：/?layout=compact
NEXT_PUBLIC_WORKBENCH_LAYOUT=default

# 首页布局：mixed（默认）| classic | fixmystreet
# URL 可覆盖：/?nav=classic 、/?nav=mixed 、/?nav=fixmystreet
NEXT_PUBLIC_HOME_NAV=mixed
# 旧变量（仅当未设置 HOME_NAV 时生效）：true → fixmystreet
NEXT_PUBLIC_FIXMYSTREET_NAV=false

# 大赛 P0 特性开关（默认 true；URL ?legacy=1 一键全关，或 ?locationRequired=0 等单项关闭）
NEXT_PUBLIC_OBSTACLE_FALLBACK=true
NEXT_PUBLIC_LOCATION_REQUIRED=true
NEXT_PUBLIC_PUBLIC_READONLY=true
NEXT_PUBLIC_DISPATCH_SCRIPT=true

# Supabase（公开上报池 + 照片 Storage）
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 可选：高德 Web 服务 Key，未配置时使用 OpenStreetMap 嵌入
# 逆地理路名解析走服务端 /api/geocode，Production 配 NEXT_PUBLIC_AMAP_KEY 或 AMAP_WEB_KEY 均可
NEXT_PUBLIC_AMAP_KEY=
AMAP_WEB_KEY=
