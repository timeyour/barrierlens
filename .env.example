GEMINI_API_KEY=
# 兼容旧变量名
GEMMA_API_KEY=
GEMMA_MODEL_NAME=gemma-4-26b-a4b-it
GEMMA_API_TIMEOUT_MS=25000
GEMMA_API_RETRY_ATTEMPTS=2
# 本地网络需要代理时填写，例如 http://127.0.0.1:7897；Vercel 通常留空
GEMMA_API_PROXY=

NEXT_PUBLIC_V2_ENABLED=true
NEXT_PUBLIC_V2_BARRIER_MAP_ENABLED=true
NEXT_PUBLIC_V2_REVIEW_FLOW_ENABLED=true

# Supabase（公开上报池 + 照片 Storage）
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 可选：高德静态地图 key，未配置时使用 OpenStreetMap 嵌入
NEXT_PUBLIC_AMAP_KEY=
